# --- Telegram: my.telegram.org/apps ---
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Группа-источник: @username или ссылка t.me/... (группа должна быть публичной)
TG_CHANNEL=
# Получатель форвардов: @username или me = Избранное
TG_RECIPIENT=

# --- LLM: OpenAI-совместимый эндпоинт с response_format=json_schema ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Прочее ---
# socks5h://user:pass@host:1080 — разом для Telegram и LLM; пусто = напрямую
SOCKS5_PROXY=
# сколько последних постов разобрать при первом запуске
BACKFILL=10
# как часто опрашивать историю группы
POLL_INTERVAL=30s
# приложение и кейворды лежат в /app, данные — в /data
KEYWORDS_PATH=keywords.txt
PROMPT_PATH=prompt.md
DATA_DIR=/data
LOG_LEVEL=info
